# Copy to .env at the repo root (mode 600) and fill in real values.
# NEVER commit the real .env (see .gitignore); this file only holds
# placeholders (AGENTS.md: "Never hardcode credentials or expose secrets").

# Required. The key handed to the jury via X-API-Key. Generate with e.g.
# `openssl rand -hex 32`; never reuse a key from another system.
API_KEY=replace-with-a-long-random-value

# "vlm" (primary) or "f1" (fallback); see architecture.md §1/§7.
DETECTOR=f1
# jury (default): report only rules whose norms a person verified on adilet; the service refuses
# to start while none is. detector: every enabled rule, citations marked pending (experiments only).
RULE_SCOPE=jury

# Per-job budget in seconds (upload receipt + this = the job's deadline).
JOB_BUDGET_S=270

# Upload size cap in bytes; task.md: files are ~29 MiB, .mov only.
MAX_UPLOAD_BYTES=67108864

# How long a finished job's result stays in the store before being purged.
RESULTS_TTL_HOURS=24

# F1 fallback only (ignored when DETECTOR=vlm):
DEVICE=auto
CPU_THREADS=4

# VLM primary only (ignored when DETECTOR=f1); deploy/vllm/serve.sh binds
# vLLM to 127.0.0.1:8010, matching the default below.
VLM_BASE_URL=http://127.0.0.1:8010/v1
VLM_MODEL=Qwen/Qwen3.5-9B

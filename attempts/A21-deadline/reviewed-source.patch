@@ -0,0 +1,349 @@
+:root {
+  color-scheme: light;
+  --bg: #f5f5f1; --surface: #fff; --ink: #252c28; --muted: #68726b;
+  --line: #dce0d9; --accent: #226c50; --accent-soft: #edf5ef;
+  --warning: #8b641d; --warning-soft: #fbf5e8; --danger: #b23838;
+  font: 14px/1.5 "Aptos", "Segoe UI", system-ui, sans-serif;
+}
+* { box-sizing: border-box; }
+body { margin: 0; background: var(--bg); color: var(--ink); }
+button, input, select, textarea { font: inherit; color: inherit; border: 1px solid var(--line); border-radius: 6px; background: var(--surface); }
+button { padding: 7px 11px; cursor: pointer; font-weight: 550; transition: background .15s, border-color .15s; }
+button:hover:not(:disabled) { background: var(--accent-soft); border-color: #99b2a4; }
+button:active:not(:disabled) { transform: translateY(1px); }
+button:disabled { opacity: .45; cursor: default; }
+button.primary { background: var(--accent); color: white; border-color: var(--accent); }
+button.primary:hover:not(:disabled) { background: #19543e; }
+input, select, textarea { padding: 8px 9px; min-width: 0; width: 100%; }
+input[type=checkbox] { width: 16px; height: 16px; accent-color: var(--accent); flex: none; }
+input::placeholder, textarea::placeholder { color: #89918b; }
+textarea { resize: vertical; line-height: 1.6; }
+a { color: var(--accent); text-decoration: none; }
+a:hover { text-decoration: underline; }
+:focus-visible { outline: 3px solid #66a88b; outline-offset: 3px; }
+label { display: flex; flex-direction: column; gap: 5px; font-size: 12px; font-weight: 550; }
+h1, h2, p { margin: 0; }
+h1 { font-size: 24px; letter-spacing: -.6px; font-weight: 650; }
+h2 { font-size: 14px; font-weight: 650; }
+ol { margin: 0; padding: 0; list-style: none; }
+[hidden] { display: none !important; }
+.muted, .optional { color: var(--muted); font-weight: 400; }
+.optional { font-size: 11px; }
+.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
+.skip { position: absolute; top: -100px; left: 20px; background: white; padding: 10px; z-index: 10; }
+.skip:focus { top: 10px; }
+.app-header { min-height: 76px; display: flex; align-items: center; gap: 36px; border-bottom: 1px solid var(--line); padding: 12px 28px; background: var(--surface); }
+.brand { display: flex; align-items: center; gap: 10px; color: var(--accent); font-size: 18px; font-weight: 650; white-space: nowrap; letter-spacing: -.3px; }
+.brand-sub { color: var(--ink); font-weight: 450; }
+.app-header nav { display: flex; gap: 25px; align-items: center; font-size: 13px; }
+.app-header nav a { color: var(--muted); padding: 10px 0; }
+.app-header nav [aria-current] { color: var(--accent); box-shadow: 0 2px var(--accent); }
+.annotator { margin-left: auto; flex-direction: row; align-items: center; white-space: nowrap; gap: 9px; color: var(--muted); }
+.annotator input { width: 175px; font-size: 12px; }
+.app-layout { max-width: 1760px; margin: auto; display: grid; grid-template-columns: 184px minmax(0,1fr); min-height: calc(100dvh - 77px); }
+.clip-sidebar { border-right: 1px solid var(--line); padding: 25px 14px; display: flex; flex-direction: column; gap: 14px; }
+.sidebar-heading, .section-heading { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
+.sidebar-heading { padding: 0 4px; }
+.sidebar-heading h2 { font-size: 16px; }
+.clip-sidebar input[type=search] { font-size: 12px; }
+.filter-label { display: flex; flex-direction: row; align-items: center; gap: 7px; font-weight: 400; cursor: pointer; }
+.progress-label { font-size: 11px; color: var(--muted); padding: 0 4px; }
+.clip-list { display: flex; flex-direction: column; gap: 3px; max-height: calc(100dvh - 310px); overflow: auto; scrollbar-width: thin; }
+.clip-button { display: flex; align-items: center; justify-content: space-between; gap: 6px; padding: 10px; border-color: transparent; background: transparent; text-align: left; min-height: 43px; }
+.clip-button[aria-current=true] { background: var(--accent-soft); border-color: #c5dacb; color: var(--accent); }

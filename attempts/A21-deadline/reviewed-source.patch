+  if (content !== undefined) element.textContent = String(content);
+  if (className) element.className = className;
+  return element;
+}
+
+function badge(value) {
+  const style = ["supported", "contradicted", "unknown"].includes(value) ? value : "";
+  return node("span", text(value), `chip ${style}`);
+}
+
+function metric(parent, label, value) {
+  const card = node("div", undefined, "stat");
+  card.append(node("div", count(value), "value"), node("div", label, "muted"));
+  parent.append(card);
+}
+
+function observations(clip) {
+  const details = node("details");
+  const human = clip.human_observation;
+  details.append(node("summary", `Human observations · ${text(human?.review_status ?? clip.human_annotation_coverage)}`));
+  if (!human || typeof human !== "object") {
+    details.append(node("p", "No human observation supplied; this does not establish compliance."));
+    return details;
+  }
+  if (human.review_note) details.append(node("p", text(human.review_note)));
+  if (human.cause_unresolved) details.append(node("p", "Cause unresolved; no reason score.", "unknown"));
+  if (human.recording_cutoff) details.append(node("p", "Recording cutoff: later custody or abandonment is unknown.", "muted"));
+  const events = node("ul");
+  for (const event of list(human.events)) {
+    const interval = list(event?.interval_sec);
+    const when = interval.length === 2 ? `${time(interval[0])} – ${time(interval[1])}` : "human time unknown";
+    events.append(node("li", `${text(event?.description)} (${when})`));
+  }
+  details.append(events);
+  const checks = node("ul");
+  for (const check of list(human.reason_checks)) {
+    checks.append(node("li", `${list(check?.rule_ids).map(text).join(", ")}: ${text(check?.status)}. ${text(check?.explanation)}`));
+  }
+  details.append(checks, node("p", `Observation source: ${text(human.provenance_id)}. Legal/policy: ${text(clip.legal_policy_status)}.`, "muted"));
+  return details;
+}
+
+function render(data) {
+  if (data?.schema_version !== 1 || !data.summary || !Array.isArray(data.clips) ||
+      !data.clips.every((clip) => clip && typeof clip === "object" && !Array.isArray(clip))) {
+    throw new Error("Unsupported or invalid evaluation audit schema.");
+  }
+  const summary = data.summary;
+  $("samples").textContent = `${count(summary.unique_sha_groups)} unique videos · ${count(summary.organizer_samples)} organizer files · ${count(summary.duplicate_samples)} duplicate samples`;
+  for (const [key, label] of [["TP", "True positives"], ["TN", "True negatives"], ["FP", "False positives"], ["FN", "False negatives"], ["missing", "Missing predictions"], ["invalid", "Invalid predictions"], ["failed", "Failed predictions"], ["label_conflict", "Label conflicts"]]) {
+    metric($("verdicts"), label, summary.unique_verdict_confusion?.[key]);
+  }
+  for (const key of ["supported", "contradicted", "unknown"]) {
+    metric($("reasons"), key, summary.finding_reason_counts?.[key]);
+  }
+  $("provenance").textContent = [data.scope, data.assertion_provenance?.source, data.assertion_provenance?.authority, data.assertion_provenance?.support_definition].filter((s) => typeof s === "string").join(" ");
+  for (const caveat of list(data.limitations)) $("caveats").append(node("li", text(caveat)));
+  for (const clip of data.clips) {
+    const row = node("tr");
+    const names = node("td");
+    for (const id of list(clip.clip_ids)) {
+      if (names.childNodes.length) names.append(document.createTextNode(", "));
+      const link = node("a", text(id));
+      link.href = `/annotate?clip=${encodeURIComponent(text(id))}`;
+      names.append(link);
+    }
+    if (!names.childNodes.length) names.textContent = "Unspecified group";
+    row.append(names);
+    const predicted = node("td");
+    predicted.append(badge(clip.predicted_verdict), node("p", `State: ${text(clip.prediction_state)}`, "muted"));
+    const organizer = node("td");
+    if (!Array.isArray(clip.organizer_files) || !clip.organizer_files.length) organizer.append(node("p", "not reported"));
+    for (const file of list(clip.organizer_files)) {
+      const markers = Array.isArray(file?.timestamps_sec) ? file.timestamps_sec.map(time).join(", ") || "no marker supplied" : "markers not reported";
+      organizer.append(node("p", `${text(file?.clip_id)}: ${text(file?.verdict)} · ${markers}`));
+    }
+    row.append(predicted, organizer, node("td", text(clip.unique_outcome)));
+    const findings = node("td");
+    if (!Array.isArray(clip.findings)) findings.append(node("p", "Findings not reported."));
+    else if (!clip.findings.length) findings.append(node("p", "No findings reported.", "muted"));
+    for (const finding of list(clip.findings)) {
+      const block = node("div", undefined, "finding");
+      block.append(node("p", `${text(finding?.rule_id)} @ ${time(finding?.t)}`), badge(finding?.reason_status), node("p", text(finding?.explanation), "muted"));
+      findings.append(block);
+    }
+    const human = node("td");
+    human.append(observations(clip));
+    row.append(findings, human);
+    $("clips").append(row);
+  }
+  $("status").textContent = "Published evaluation snapshot. Reload to check for a newer report.";
+  $("report").hidden = false;
+}
+
+async function load() {
+  try {
+    const response = await fetch("/api/evaluation", { cache: "no-store" });
+    if (response.status === 404) throw new Error("Evaluation not ready: report has not been published.");
+    if (!response.ok) throw new Error(`Evaluation unavailable (HTTP ${response.status}).`);
+    let data;
+    try { data = await response.json(); }
+    catch { throw new Error("Evaluation unavailable: report is not valid JSON."); }
+    render(data);
+  } catch (error) {
+    $("report").hidden = true;
+    $("status").textContent = error.message || "Evaluation could not be loaded. Reload to retry.";
+  }
+}
+load();
+</script>
+</body>
+</html>
diff --git a/scripts/remote_codex_worker.sh b/scripts/remote_codex_worker.sh
new file mode 100755
index 0000000..5672cf3
--- /dev/null
+++ b/scripts/remote_codex_worker.sh
@@ -0,0 +1,111 @@
+#!/usr/bin/env bash
+set -euo pipefail
+umask 077
+export PATH="$HOME/.local/bin:$PATH"
+
+if [ "$#" -ne 3 ]; then
+    echo "Usage: codex-worker {submit|resume|status|result} {1|2} TASK_ID" >&2
+    exit 2
+fi
+operation=$1
+slot=$2
+task_id=$3
+case "$slot" in 1|2) ;; *) echo "Worker slot must be 1 or 2." >&2; exit 2 ;; esac
+if [[ ! "$task_id" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$ ]]; then
+    echo "Task ID must contain 1-64 letters, numbers, underscores, or hyphens." >&2
+    exit 2
+fi
+
+pool="$HOME/workspaces/datathon26-workers"
+workspace="$pool/worker-$slot"
+job_dir="$pool/runs/worker-$slot/$task_id"
+self="$HOME/.local/bin/codex-worker"
+
+case "$operation" in
+    submit|resume)
+        test -d "$workspace/.git" || test -f "$workspace/.git"
+        tmux -L codex-workers has-session -t '=implementation'
+        task_text=$(cat)
+        if [ -z "$task_text" ]; then echo "Task text on stdin is required." >&2; exit 2; fi
+        task_text=$(printf '%s\n\n%s' 'Use $ponytail: read ~/.agents/skills/ponytail/SKILL.md. Deliver the smallest complete change with measured benefit; reuse existing code and keep meaningful validation.' "$task_text")
+        if [ "$operation" = submit ]; then
+            mkdir -p "$(dirname "$job_dir")"
+            mkdir "$job_dir"
+        else
+            case "$(cat "$job_dir/status")" in
+                completed|failed) ;;
+                *) echo "Only a stopped task can be resumed." >&2; exit 4 ;;
+            esac
+            thread_id=$(python3 -c 'import json,sys; print(json.loads(open(sys.argv[1]).readline())["thread_id"])' "$job_dir/events.jsonl")
+            history_dir="$job_dir/history/$(date -u +%Y%m%dT%H%M%SZ)"
+            mkdir -p "$history_dir"
+            for artifact in task.txt status exit-code result.md events.jsonl stderr.log runner.log changes.patch git-status.txt untracked.tar.gz base-commit; do
+                if [ -f "$job_dir/$artifact" ]; then cp -a "$job_dir/$artifact" "$history_dir/"; fi
+            done
+            printf '%s\n' "$thread_id" > "$job_dir/resume-thread"
+        fi
+        printf '%s\n' "$task_text" > "$job_dir/task.txt"
+        printf 'queued\n' > "$job_dir/status"
+        launch=$(printf '%q ' "$self" _run "$slot" "$task_id")
+        launch="$launch >$(printf '%q' "$job_dir/runner.log") 2>&1"
+        if ! tmux -L codex-workers new-window -d -t implementation \
+            -n "$slot-$task_id" "$launch"; then
+            printf 'failed\n' > "$job_dir/status"
+            printf '1\n' > "$job_dir/exit-code"
+            exit 1
+        fi
+        printf '%s\n' "$job_dir"
+        ;;
+    _run)
+        trap 'worker_exit=$?; printf "%s\n" "$worker_exit" > "$job_dir/exit-code"; if [ "$worker_exit" -eq 0 ]; then printf "completed\n" > "$job_dir/status"; else printf "failed\n" > "$job_dir/status"; fi' EXIT
+        mkdir -p "$pool/locks"
+        exec 9>"$pool/locks/worker-$slot.lock"
+        flock 9
+        printf 'running\n' > "$job_dir/status"
+        cd "$workspace"
+        if [ -n "$(git status --porcelain)" ] && [ ! -f "$job_dir/resume-thread" ]; then
+            echo "Worker has unreviewed changes. Commit reviewed work before submitting another task." >&2
+            exit 3
+        fi
+        source .venv/bin/activate
+        export PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=2 MKL_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2
+        if [ ! -f "$job_dir/base-commit" ]; then git rev-parse HEAD > "$job_dir/base-commit"; fi
+        codex_args=(exec --profile implementation --cd "$workspace" --json --output-last-message "$job_dir/result.md")
+        if [ -f "$job_dir/resume-thread" ]; then codex_args+=(resume "$(cat "$job_dir/resume-thread")"); fi
+        if codex "${codex_args[@]}" - \
+            < "$job_dir/task.txt" > "$job_dir/events.jsonl" 2> "$job_dir/stderr.log" 9>&-; then
+            agent_exit=0
+        else
+            agent_exit=$?
+        fi
+        git diff --binary "$(cat "$job_dir/base-commit")" > "$job_dir/changes.patch"
+        git status --porcelain > "$job_dir/git-status.txt"
+        git ls-files --others --exclude-standard -z \
+            | tar --null -T - -czf "$job_dir/untracked.tar.gz"
+        exit "$agent_exit"
+        ;;
+    status)
+        cat "$job_dir/status"
+        if [ -f "$job_dir/exit-code" ]; then
+            printf 'exit_code='
+            cat "$job_dir/exit-code"
+        fi
+        ;;
+    result)
+        job_state=$(cat "$job_dir/status")
+        case "$job_state" in
+            completed|failed) ;;
+            *) echo "Task is $job_state; its result is not final." >&2; exit 4 ;;
+        esac
+        if [ ! -f "$job_dir/result.md" ]; then
+            echo "No final agent report. Inspect $job_dir/runner.log and stderr.log." >&2
+            exit 1
+        fi
+        cat "$job_dir/result.md"
+        exit "$(cat "$job_dir/exit-code")"
+        ;;
+    *)
+        echo "Unknown operation: $operation" >&2
+        exit 2
+        ;;
+esac
diff --git a/tests/test_realtime_descriptions.py b/tests/test_realtime_descriptions.py
new file mode 100644
index 0000000..1ecbcf1
--- /dev/null
+++ b/tests/test_realtime_descriptions.py
@@ -0,0 +1,112 @@
+"""Draft provenance, safe retrieval, and description-only review without invented times."""
+
+import json
+
+import pytest
+from pydantic import ValidationError
+
+from realtime.annotations import Annotation, AnnotationStore
+from realtime.descriptions import DescriptionDraft, write_draft
+from tests.test_realtime_gateway import FakeChecker, make_client, receive_until_finished
+
+
+def ready(clip="X-1"):
+    return DescriptionDraft(
+        clip=clip,
+        status="ready",
+        description="Synthetic description for endpoint tests.",
+        model="test-local-model",
+        sampled_timestamps=[0, 1, 2, 3],
+    )
+
+
+def test_ready_drafts_require_model_text_and_valid_sample_times():
+    with pytest.raises(ValidationError):
+        DescriptionDraft(clip="X-1", status="ready")
+    with pytest.raises(ValidationError):
+        DescriptionDraft.model_validate(
+            ready().model_dump() | {"sampled_timestamps": [float("nan")]}
+        )
+    with pytest.raises(ValidationError):
+        DescriptionDraft(clip="../X-1", status="queued")
+    with pytest.raises(ValidationError):
+        DescriptionDraft(clip="X-1", status="failed")
+
+
+def test_description_retrieval_is_separate_from_human_annotations(tmp_path):
+    videos = tmp_path / "videos"
+    videos.mkdir()
+    (videos / "X-1.mov").write_bytes(b"synthetic fixture")
+    store = AnnotationStore(tmp_path / "annotations")
+    saved = store.save("X-1", Annotation(summary="Human correction"), base_version=0)
+    with make_client(
+        tmp_path, FakeChecker(), video_dir=videos, state_file=tmp_path / "state.json"
+    ) as client:
+        assert client.get("/api/annotation-description/X-1").json()["status"] == "unavailable"
+        write_draft(tmp_path / "descriptions", ready())
+        response = client.get("/api/annotation-description/X-1")
+        assert response.status_code == 200
+        assert response.json()["description"] == ready().description
+        assert client.get("/api/annotation-description/X-99").status_code == 404
+        assert client.get("/api/annotation-description/..%2Fstate").status_code == 404
+        write_draft(tmp_path / "descriptions", DescriptionDraft(clip="X-1", status="processing"))
+        assert client.get("/api/annotation-description/X-1").json()["status"] == "processing"
+    assert store.load("X-1") == saved
+
+
+def test_invalid_drafts_are_reported_explicitly(tmp_path):
+    videos = tmp_path / "videos"
+    videos.mkdir()
+    (videos / "X-1.mov").write_bytes(b"synthetic fixture")
+    drafts = tmp_path / "descriptions"
+    drafts.mkdir()
+    path = drafts / "X-1.json"
+    path.write_text(json.dumps(ready("X-2").model_dump()))
+    with make_client(
+        tmp_path, FakeChecker(), video_dir=videos, state_file=tmp_path / "state.json"
+    ) as client:
+        assert client.get("/api/annotation-description/X-1").status_code == 500
+        path.write_text("{broken")
+        assert client.get("/api/annotation-description/X-1").status_code == 500
+
+
+def test_description_corrections_keep_ai_provenance_and_need_no_timestamps(tmp_path):
+    store = AnnotationStore(tmp_path)
+    first = store.save(
+        "X-1",
+        Annotation(
+            summary="A corrected whole-clip description. " * 80,
+            description_source="ai_draft",
+            description_model="test-local-model",
+            status="done",
+        ),
+        base_version=0,
+    )
+    assert first.assisted and first.rows == []
+    assert first.description_model == "test-local-model"
+    assert store.load("X-1").summary == first.summary
+    second = store.save("X-1", Annotation(summary="A later edit"), base_version=first.version)
+    assert second.assisted
+
+
+def test_descriptions_without_times_do_not_produce_false_event_scores(tmp_path):
+    videos = tmp_path / "videos"
+    videos.mkdir()
+    (videos / "X-1.mov").write_bytes(b"synthetic fixture")
+    fake = FakeChecker()
+    client = make_client(tmp_path, fake, video_dir=videos, state_file=tmp_path / "state.json")
+    with client, client.websocket_connect("/ws") as ws:
+        ws.receive_json()
+        client.post("/api/run-folder")
+        receive_until_finished(ws, 1)
+        client.put(
+            "/api/annotations/X-1?base_version=0",
+            json={
+                "summary": "A person approaches the desk.",
+                "status": "done",
+            },
+        )
+        result = client.get("/api/annotations-score").json()
+    assert result["clips"] == []
+    assert result["description_only"] == ["X-1"]
+    assert result["summary"]["per_action"] == {}
diff --git a/tests/test_audit_findings.py b/tests/test_audit_findings.py
new file mode 100644
index 0000000..6edc941
--- /dev/null
+++ b/tests/test_audit_findings.py
@@ -0,0 +1,457 @@
+"""Audit fixtures exercise reason/verdict independence without running or mocking inference."""
+
+from __future__ import annotations
+
+import json
+from copy import deepcopy
+from pathlib import Path
+
+import pytest
+
+from eval.audit_findings import audit, dump_json, main, make_manifest, run_manifest
+
+OLD_CASH = "S-CLEAN-DESK-HANDOVER"
+ID = "C-ID-BEFORE-CASH"
+LEAVE = "L-NO-DOCS-ON-LEAVE"
+PROVENANCE = {"id": "synthetic-human-account", "kind": "test_fixture_not_organizer_reason"}
+
+
+def label(clip: int, sha: str = "a" * 64, positive: bool = True, t: float = 57) -> dict:
+    return {
+        "sha256": sha,
+        "original_id": f"X-{clip}",
+        "duration_sec": 100,
+        "organizer_verdict": "violation" if positive else "no_violation",
+        "organizer_timestamps": [t] if positive else [],
+    }
+
+
+def prediction(rule: str | None = None, t: float = 57, sha: str = "a" * 64) -> dict:
+    return {"sha256": sha, "findings": [{"rule_id": rule, "t": t}] if rule else []}
+
+
+def observation(clip_ids: list[str], rule: str, status: str, interval=None, **kwargs) -> dict:
+    return {
+        "clip_ids": clip_ids,
+        "provenance_id": PROVENANCE["id"],
+        "coverage": "partial",
+        "events": [{"id": "observed-event", "interval_sec": interval}],
+        "reason_checks": [
+            {
+                "rule_ids": [rule],
+                "status": status,
+                "event_ids": ["observed-event"],
+                "explanation": "Fixture observation.",
+            }
+        ],
+        **kwargs,
+    }
+
+
+def assertions(*clips: dict) -> dict:
+    return {"schema_version": 1, "provenance": PROVENANCE, "clips": list(clips)}
+
+
+def evaluate(labels: list[dict], predictions: list[dict], observed: dict | None = None) -> dict:
+    return audit(
+        "\n".join(json.dumps(row) for row in labels),
+        [({"path": "explicit-replay.jsonl"}, "\n".join(json.dumps(row) for row in predictions))],
+        observed if observed is not None else assertions(),
+    )
+
+
+def test_correct_binary_verdict_wrong_reason_never_gets_timing_credit():
+    report = evaluate(
+        [label(4), label(47, t=68)],
+        [prediction(ID, 68)],
+        assertions(observation(["X-4", "X-47"], ID, "contradicted", [57, 57])),
+    )
+    assert report["summary"]["unique_verdict_confusion"]["TP"] == 1
+    assert report["summary"]["sample_verdict_confusion"]["TP"] == 2
+    finding = report["clips"][0]["findings"][0]
+    assert finding["reason_status"] == "contradicted"
+    assert finding["compatible_event_timing"] == []
+    assert [row["signed_offsets_sec"] for row in finding["organizer_offsets"]] == [[11], [0]]
+    assert not any(row["eligible_for_compatible_timing"] for row in finding["organizer_offsets"])
+    assert report["clips"][0]["reason_audit_failures"] == 1
+
+
+def test_duplicate_timestamps_preserved_when_reason_is_compatible():
+    report = evaluate(
+        [label(4), label(47, t=68)],
+        [prediction(OLD_CASH, 57)],
+        assertions(observation(["X-4", "X-47"], OLD_CASH, "supported", [57, 57])),
+    )
+    summary, clip = report["summary"], report["clips"][0]
+    assert summary["organizer_samples"] == 2
+    assert summary["unique_sha_groups"] == summary["duplicate_samples"] == 1
+    finding = clip["findings"][0]
+    assert [f["timestamps_sec"] for f in clip["organizer_files"]] == [[57], [68]]
+    assert finding["compatible_event_timing"][0]["absolute_distance_to_interval_sec"] == 0
+    assert [row["signed_offsets_sec"] for row in finding["organizer_offsets"]] == [[0], [-11]]
+    assert finding["legal_policy_status"] == "pending_source_review"
+
+
+def test_combination_time_unknown_is_not_invented_from_organizer_marker():
+    report = evaluate(
+        [label(4)],
+        [prediction("S-NO-MERGE")],
+        assertions(observation(["X-4"], "S-NO-MERGE", "supported")),
+    )
+    timing = report["clips"][0]["findings"][0]["compatible_event_timing"][0]
+    assert timing["human_interval_sec"] is None
+    assert timing["absolute_distance_to_interval_sec"] is None
+
+
+def test_wrong_exit_reason_is_failure_even_with_matching_verdict():
+    report = evaluate(
+        [label(20, t=5)],
+        [prediction(LEAVE, 1)],
+        assertions(observation(["X-20"], LEAVE, "contradicted")),
+    )
+    assert report["clips"][0]["unique_outcome"] == "TP"
+    assert report["summary"]["finding_reason_counts"]["contradicted"] == 1
+
+
+def test_unresolved_cause_has_no_reason_score_and_no_missing_cause_guess():
+    report = evaluate(
+        [label(1, t=22)],
+        [prediction("C-REJECT-NOT-RETURNED", 22)],
+        assertions(
+            {
+                "clip_ids": ["X-1"],
+                "provenance_id": PROVENANCE["id"],
+                "coverage": "partial",
+                "cause_unresolved": True,
+                "events": [],
+                "reason_checks": [],
+            }
+        ),
+    )
+    assert report["summary"]["unknown_cause_sha_groups"] == 1
+    finding = report["clips"][0]["findings"][0]
+    assert finding["reason_status"] == "unknown"
+    assert finding["compatible_event_timing"] == []
+    assert "reason_accuracy" not in json.dumps(report)
+
+
+def test_cutoff_blocks_future_abandonment_but_clean_twin_remains_clean():
+    first, second = "a" * 64, "b" * 64
+    report = evaluate(
+        [label(43, first, False), label(45, second, False)],
+        [prediction("L-NO-CASH-ON-LEAVE", sha=first), prediction(sha=second)],
+        assertions(
+            observation(["X-43"], "L-NO-CASH-ON-LEAVE", "contradicted", recording_cutoff=True),
+            observation(["X-45"], "L-NO-CASH-ON-LEAVE", "contradicted", recording_cutoff=True),
+        ),
+    )
+    counts = report["summary"]["unique_verdict_confusion"]
+    assert counts["FP"] == counts["TN"] == 1
+    assert report["summary"]["finding_reason_counts"]["contradicted"] == 1
+
+
+def test_missing_predictions_are_missing_not_no_violation():
+    report = evaluate([label(1), label(2, "b" * 64, False)], [])
+    counts = report["summary"]["unique_verdict_confusion"]
+    assert counts["missing"] == 2
+    assert counts["FN"] == counts["TN"] == 0
+    assert report["summary"]["missing_human_annotation_sha_groups"] == 2
+
+
+@pytest.mark.parametrize(
+    "raw",
+    [
+        {"sha256": "a" * 64},
+        {"sha256": "a" * 64, "findings": None},
+        {"sha256": "a" * 64, "findings": [None]},
+        {"sha256": "a" * 64, "findings": [{"rule_id": "", "t": 3}]},
+        {"sha256": "a" * 64, "findings": [{"rule_id": ID, "t": -1}]},

+def orient_cashier_side(scene: Scene, observations: list[Observation]) -> None:
+    """Split the room along the desk's long side, cashier on the side where the person working
+    at the laptop spends the clip. Learned from the video, so it holds for any camera angle
+    (over the shoulder, facing the cashier, from the side). Manual zones win."""
+    if "cashier" in scene.zones or "desk" not in scene.objects or "laptop" not in scene.objects:
+        return
+    laptop = center(scene.objects["laptop"].box)
+    nearest = []
+    for observation in observations:
+        people = [d.position() for d in observation.detections if d.label == "person"]
+        if people:
+            point = min(people, key=lambda p: distance(p, laptop))
+            if distance(point, laptop) <= LAPTOP_REACH:
+                nearest.append(point)
+    # Clients come and go; the cashier is the one at the laptop most of the time.
+    if len(nearest) < max(3, 0.2 * len(observations)):
+        scene.confidence = 0
+        scene.warnings.append(
+            "Не видно, с какой стороны стола работает кассир; задайте ручные зоны."
+        )
+        return
+    anchor = tuple(float(np.median([p[i] for p in nearest])) for i in (0, 1))
+    x1, y1, x2, y2 = scene.objects["desk"].box
+    origin = center(scene.objects["desk"].box)
+    axis = 1 if x2 - x1 >= y2 - y1 else 0  # a desk wide in the image splits top/bottom
+    side = 1.0 if anchor[axis] >= origin[axis] else -1.0
+    scene.cashier_direction = (0.0, side) if axis else (side, 0.0)
+    scene.zones["cashier"] = half_plane(origin, scene.cashier_direction, 1)
+    scene.zones["client"] = half_plane(origin, scene.cashier_direction, -1)
+

+++ b/tests/test_camera_geometry.py
@@ -0,0 +1,29 @@
+import pytest
+import yaml
+
+from backend.f1.calibration import calibrate
+from backend.f1.vision_types import Detection
+
+
+def test_camera_geometry_is_shared_with_explicit_video_override_preserved(tmp_path):
+    path = tmp_path / "geometry.yaml"
+    camera = (0.0, 0.02, 0.34, 0.58)
+    specific = (0.6, 0.1, 0.8, 0.6)
+    path.write_text(yaml.safe_dump({"camera": {"objects": {"door": camera}},
+                                   "videos": {"a" * 64: {"objects": {"door": specific}}}}))
+    neural = Detection(label="door", score=0.6, box=(0.2, 0.0, 0.6, 0.5))
+    for checksum in ("b" * 64, "c" * 64):
+        scene = calibrate([neural], path, checksum)
+        assert scene.objects["door"].box == camera
+        assert scene.object_sources["door"] == "manual_camera"
+        assert scene.candidates == [neural]
+    scene = calibrate([neural], path, "a" * 64)
+    assert scene.objects["door"].box == specific
+    assert scene.object_sources["door"] == "manual_video"
+
+
+def test_camera_geometry_rejects_invalid_coordinates(tmp_path):
+    path = tmp_path / "geometry.yaml"
+    path.write_text("camera: {objects: {door: [0, 0, 2, 1]}}\nvideos: {}\n")
+    with pytest.raises(ValueError):
+        calibrate([], path, "b" * 64)

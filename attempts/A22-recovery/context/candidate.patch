+import json
+
+import pytest
+
+from backend.f1.events import EventLog
+from backend.f1.llm_context import build_llm_context
+from backend.f1.vision_types import Detection, Event, Observation, Scene, State
+
+
+def test_exact_samples_track_gaps_and_proxy_semantics():
+    person = Detection(
+        label="person", score=0.9, box=(0.1, 0.1, 0.3, 0.6), track_id="p1", role="cashier"
+    )
+    cash = Detection(label="cash", score=0.4, box=(0.2, 0.4, 0.3, 0.5), track_id="c1")
+    scene = Scene(objects={"safe": Detection(label="safe", score=0.3, box=(0.5, 0.2, 0.8, 0.6))})
+    observations = [
+        Observation(
+            timestamp_sec=t,
+            detections=[person, cash] if t in {0, 2} else [],
+            states={"safe": State(value="open", score=0.6, margin=0.1)} if t == 0.5 else {},
+        )
+        for t in (0, 0.5, 1, 1.5, 2)
+    ]
+    log = EventLog(
+        [
+            Event(
+                timestamp_sec=1,
+                type="HANDOVER",
+                facts={
+                    "location": "hand:p1",
+                    "session_id": "session-1",
+                    "annotation": "DO_NOT_COPY",
+                    "near": True,
+                },
+            ),
+            Event(timestamp_sec=2, type="WORKSTATION_AWAY_END", facts={"end_reason": "clip_end"}),
+        ],
+        {"safe": False},
+        [],
+        {},
+    )
+    result = build_llm_context(scene, observations, log, 1, window_s=4)
+    assert result["object_tracks"][0]["gap_intervals"] == [[0, 2]]
+    assert result["object_tracks"][0]["first_observation"]["t"] == 0
+    assert result["object_tracks"][0]["last_observation"]["t"] == 2
+    assert result["actors"][0]["role"] == "cashier"
+    assert "geometric" in result["actors"][0]["role_source"]
+    assert result["samples"][1]["state_samples"]["safe"] == {
+        "value": "open",
+        "score": 0.6,
+        "margin": 0.1,
+    }
+    assert result["samples"][2]["state_samples"] == {}
+    assert result["events"][0]["evidence_kind"] == "event_builder_inference_or_proxy"
+    assert result["events"][0]["facts"]["near"] is True
+    assert result["events"][1]["facts"]["end_reason"] == "clip_end"
+    assert result["window"]["boundary_events"][0]["end_reason"] == "clip_end"
+    assert "not proven possession" in result["interpretation"]["location_hand_or_handover"]
+    assert result["window"]["recording_end_verified"] is False
+    assert "DO_NOT_COPY" not in json.dumps(result, allow_nan=False)
+
+
+def test_budget_and_nonfinite_values_are_explicit():
+    scene = Scene.model_construct(
+        objects={},
+        zones={},
+        cashier_direction=None,
+        cashier_position=None,
+        confidence=float("nan"),
+        warnings=[],
+    )
+    detections = [
+        Detection(label="cash", track_id=f"c{i}", score=0.4, box=(0.1, 0.1, 0.2, 0.2))
+        for i in range(30)
+    ]
+    observations = [
+        Observation(
+            timestamp_sec=t / 2,
+            detections=detections,
+            states={"safe": State(value="closed", score=0.6, margin=0.1)},
+        )
+        for t in range(30)
+    ]
+    log = EventLog(
+        [
+            Event(timestamp_sec=t / 2, type="CASH_STATE", facts={"location": "desk"})
+            for t in range(30)
+        ],
+        {},
+        [],
+        {},
+    )
+    result = build_llm_context(scene, observations, log, 7, window_s=20)
+    assert (
+        len(json.dumps(result, separators=(",", ":"), ensure_ascii=False, allow_nan=False).encode())
+        <= 16000
+    )
+    assert result["scene"]["confidence"] is None
+    assert result["invalid_numeric_values"] == 1
+    assert result["omitted"]["objects"] >= 18
+    assert result["omitted"]["samples"] > 0
+    assert any(sample["t"] == 7 for sample in result["samples"])
+
+
+@pytest.mark.parametrize("target,window", [(float("nan"), 5), (1, 0)])
+def test_invalid_window_fails(target, window):
+    with pytest.raises(ValueError):
+        build_llm_context(Scene(objects={}), [], EventLog([], {}, [], {}), target, window)
